APP_NAME="Karoor ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://erp.example.com
APP_TIMEZONE=Africa/Addis_Ababa
APP_CURRENCY=ETB
APP_CURRENCY_SYMBOL=Br
APP_KEY=replace-with-at-least-32-random-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=karoor_erp
DB_USERNAME=karoor_app
DB_PASSWORD=replace-with-a-strong-unique-password
DB_TIMEZONE=+03:00

SESSION_NAME=karoor_session
SESSION_LIFETIME=28800
SESSION_IDLE_TIMEOUT=1800
SESSION_REGENERATE_INTERVAL=900
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax
TRUST_PROXY_HEADERS=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900
REMEMBER_LIFETIME=2592000
MAX_UPLOAD_BYTES=5242880
